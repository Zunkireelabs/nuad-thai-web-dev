# Copy this to .env for local development. Never commit .env or .env.production.
# Keep this file up to date — it is the team's documentation for required variables.

# Zenly (Supabase) — public read-only services feed for the Services page.
# The anon key is safe to expose client-side (same trust level as a Maps key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
